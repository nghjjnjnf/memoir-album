# 请只填写重新生成的密钥，不要使用已经在聊天中暴露的密钥。
DEEPSEEK_API_KEY=replace_with_a_new_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# true：完全本地演示，不调用外部模型；false：调用 DeepSeek。
USE_MOCK_LLM=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATA_DIR=./data
MAX_UPLOAD_MB=10

# disabled：不识图；deepseek_api：调用独立的 DeepSeek 视觉 API。
VISION_MODE=disabled
DEEPSEEK_VISION_API_KEY=replace_with_a_vision_key
DEEPSEEK_VISION_BASE_URL=https://api.deepseek.com
VISION_MODEL=deepseek-v4-flash-vision-exp
VISION_TIMEOUT_SECONDS=240

# 上下文压缩：估算输入超过触发阈值后，把旧对话滚动摘要到目标预算附近。
CONTEXT_COMPRESSION_TRIGGER_TOKENS=6000
CONTEXT_COMPRESSION_TARGET_TOKENS=3500
CONTEXT_RECENT_TURNS=10
LIFE_SNAPSHOT_MAX_PEOPLE=24
LIFE_SNAPSHOT_MAX_EVENTS=30
